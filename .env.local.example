# Segredo para o Publisher Agent publicar artigos via API local
PUBLISH_SECRET=troque-por-uma-senha-forte

# GitHub (para o Publisher Agent em produção no Vercel)
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=seu-usuario
GITHUB_REPO=futebolia
GITHUB_BRANCH=main

# Vercel Deploy Hook (aciona rebuild após novo artigo)
VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/...

# Telegram (Monitor Agent — notificações diárias)
TELEGRAM_BOT_TOKEN=seu-token-do-botfather
TELEGRAM_CHAT_ID=seu-chat-id

# Cron (protege o endpoint de relatório diário)
CRON_SECRET=troque-por-uma-senha-forte
